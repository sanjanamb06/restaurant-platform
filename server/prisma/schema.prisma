generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CHEF
  CASHIER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum StockChangeReason {
  ORDER_DEDUCTION
  MANUAL_ADJUSTMENT
}

model Restaurant {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  contactEmail        String
  address             String
  phone               String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  refreshTokens       RefreshToken[]
  tables              Table[]
  categories          Category[]
  menuItems           MenuItem[]
  ingredients         Ingredient[]
  menuItemIngredients MenuItemIngredient[]
  guestSessions       GuestSession[]
  orders              Order[]
  orderItems          OrderItem[]
  payments            Payment[]
  demandForecasts     DemandForecast[]
  stockHistory        StockHistory[]
}

model User {
  id                 String         @id @default(cuid())
  restaurantId       String
  name               String
  username           String         @unique
  passwordHash       String
  role               Role
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  restaurant         Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]

  @@index([restaurantId])
}

model RefreshToken {
  id           String     @id @default(cuid())
  restaurantId String
  userId       String
  tokenHash    String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
}

model Table {
  id            String         @id @default(cuid())
  restaurantId  String
  tableNumber   String
  qrCodeUrl     String?
  createdAt     DateTime       @default(now())
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestSessions GuestSession[]
  orders        Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model MenuItem {
  id              String               @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  price           Decimal              @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients     MenuItemIngredient[]
  orderItems      OrderItem[]
  demandForecasts DemandForecast[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Ingredient {
  id                String               @id @default(cuid())
  restaurantId      String
  name              String
  unit              String
  currentStock      Float                @default(0)
  lowStockThreshold Float?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems         MenuItemIngredient[]
  stockHistory      StockHistory[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// unit is owned by Ingredient to prevent unit-mismatch bugs in inventory deduction.
model MenuItemIngredient {
  id           String     @id @default(cuid())
  restaurantId String
  menuItemId   String
  ingredientId String
  quantity     Float
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([restaurantId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model GuestSession {
  id           String     @id @default(cuid())
  restaurantId String
  tableId      String
  customerName String
  sessionToken String     @unique
  createdAt    DateTime   @default(now())
  lastOrderAt  DateTime?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders       Order[]

  @@index([restaurantId])
  @@index([tableId])
}

model Order {
  id                  String        @id @default(cuid())
  restaurantId        String
  tableId             String
  guestSessionId      String?
  orderNumber         String
  customerName        String
  status              OrderStatus   @default(PENDING)
  specialInstructions String?
  totalAmount         Float?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table               Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  guestSession        GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payment             Payment?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([tableId])
  @@index([guestSessionId])
}

model OrderItem {
  id           String     @id @default(cuid())
  restaurantId String
  orderId      String
  menuItemId   String
  quantity     Int
  priceAtOrder Float
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId])
  @@index([restaurantId])
  @@index([orderId])
  @@index([menuItemId])
}

model IdempotencyRecord {
  id               String   @id @default(cuid())
  key              String   @unique
  responseSnapshot Json
  createdAt        DateTime @default(now())
}

model Payment {
  id            String     @id @default(cuid())
  restaurantId  String
  orderId       String     @unique
  amount        Decimal    @db.Decimal(10, 2)
  gstAmount     Decimal    @db.Decimal(10, 2)
  method        String
  status        String
  receiptNumber String
  createdAt     DateTime   @default(now())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, receiptNumber])
  @@index([restaurantId])
}

model DemandForecast {
  id                String     @id @default(cuid())
  restaurantId      String
  forecastDate      DateTime   @db.Date
  menuItemId        String
  predictedQuantity Decimal    @db.Decimal(12, 3)
  confidence        Decimal    @db.Decimal(5, 4)
  createdAt         DateTime   @default(now())
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem          MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, forecastDate, menuItemId])
  @@index([restaurantId])
  @@index([menuItemId])
}

model StockHistory {
  id           String            @id @default(cuid())
  restaurantId String
  ingredientId String
  changeAmount Float
  reason       StockChangeReason
  referenceId  String?           // orderId or paymentId for traceability
  createdAt    DateTime          @default(now())
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([ingredientId])
  @@index([restaurantId, createdAt])
}
